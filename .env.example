# Copy to .env.local for local development. Never commit .env.local.

# Supabase project "talkprint" (public values, safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://lcxcvowxzwymkeyillll.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Runpod Serverless (secret key, server only). Endpoint id is public.
# Set by Azael in Vercel; never pasted in chat.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# Hugging Face read token for the pyannote model. Lives in the Runpod
# endpoint's environment, not here. Listed so nobody forgets it exists.
# HF_TOKEN=

# Vercel only. Vercel sends "Authorization: Bearer <CRON_SECRET>" to cron routes.
CRON_SECRET=

# Removed: OPENAI_API_KEY, OPENAI_TRANSCRIBE_MODEL. The OpenAI engine is being
# replaced by the Runpod worker (see CLAUDE.md, step 4). Until that lands,
# src/lib/transcribe.ts still reads OPENAI_API_KEY; do not deploy in that state.
