# Copy to .env.local for local development. Never commit .env.local.

# Supabase project "talkprint" (public values, safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://lcxcvowxzwymkeyillll.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# OpenAI API key (secret, server only). Used for gpt-4o-transcribe-diarize.
OPENAI_API_KEY=

# Optional. Model id for transcription. Defaults to gpt-4o-transcribe-diarize.
OPENAI_TRANSCRIBE_MODEL=

# Vercel only. Vercel sends "Authorization: Bearer <CRON_SECRET>" to cron routes.
CRON_SECRET=
